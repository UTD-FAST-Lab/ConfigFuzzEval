"constraints": [
    {
      "opt": "pixarlog",
      "val": true,
      "then": [
        {
          "opt": "zlib",
          "val": true
        }
      ],
      "desc": "pixarlog is force disabled if zlib is not true"
    },
    {
      "opt": "libdeflate",
      "val": true,
      "then": [
        {
          "opt": "zlib",
          "val": true
        }
      ],
      "desc": "libdeflate is force disabled if zlib is not true"
    },
    {
      "opt": "old-jpeg",
      "val": true,
      "then": [
        {
          "opt": "jpeg",
          "val": true
        }
      ],
      "desc": "Old JPEG support requires standard JPEG support to be enabled."
    },
    {
      "opt": "jpeg12",
      "val": true,
      "then": [
        {
          "opt": "jpeg",
          "val": true
        }
      ],
      "desc": "libtiff's architecture requires the base JPEG infrastructure (JPEG_SUPPORT) to be active for any JPEG-related functionality to work correctly."
    },
    {
      "opt": "zlib-include-dir",
      "val": true,
      "then": [
        {
          "opt": "zlib",
          "val": true
        }
      ],
      "desc": "Directory Options (*-include-dir) require the Library (*)"
    },
    {
      "opt": "libdeflate-include-dir",
      "val": true,
