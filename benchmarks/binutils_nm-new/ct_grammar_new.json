{
  "name": "binutils_toplevel",
  "options": [
    {
      "name": "system-zlib",
      "type": "bool",
      "default": false,
      "cli": "with"
    },
    {
      "name": "system-readline",
      "type": "bool",
      "default": false,
      "cli": "with"
    },
    {
      "name": "newlib",
      "type": "bool",
      "default": false,
      "cli": "with"
    },
    {
      "name": "gnu-as",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "gnu-ld",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "as-accelerator-for",
      "type": "choice",
      "default": null,
      "cli": "enable",
      "choices": ["x86_64-pc-linux-gnu", "aarch64-linux-gnu", "nvptx-none"]
    },
    {
      "name": "offload-targets",
      "type": "choice",
      "default": null,
      "cli": "enable",
      "choices": ["nvptx-none", "amdgcn-amdhsa", "x86_64-linux-gnu"]
    },
    {
      "name": "gold",
      "type": "choice",
      "default": "no",
      "cli": "enable",
      "choices": ["yes", "no", "default"]
    },
    {
      "name": "ld",
      "type": "choice",
      "default": "yes",
      "cli": "enable",
      "choices": ["yes", "no", "default"]
    },
    {
      "name": "compressed-debug-sections",
      "type": "choice",
      "default": "none",
      "cli": "enable",
      "choices": ["all", "gas", "gold", "ld", "none"]
    },
    {
      "name": "libquadmath",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "libquadmath-support",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "libada",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "libssp",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "libstdcxx",
      "type": "choice",
      "default": "default",
      "cli": "enable",
      "choices": ["yes", "no", "default"]
    },
    {
      "name": "liboffloadmic",
      "type": "choice",
      "default": "no",
      "cli": "enable",
      "choices": ["no", "host", "target"]
    },
    {
      "name": "libgomp",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "libatomic",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "libitm",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "libsanitizer",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "libvtv",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "libhsail-rt",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "gdbserver",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "libgo",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "bootstrap",
      "type": "choice",
      "default": "default",
      "cli": "enable",
      "choices": ["yes", "no", "default"]
    },
    {
      "name": "pgo-build",
      "type": "choice",
      "default": "no",
      "cli": "enable",
      "choices": ["yes", "no", "lto"]
    },
    {
      "name": "mpc",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["/usr/local", "/opt/mpc", "/usr"]
    },
    {
      "name": "mpc-include",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["/usr/local/include", "/opt/mpc/include"]
    },
    {
      "name": "mpc-lib",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["/usr/local/lib", "/opt/mpc/lib"]
    },
    {
      "name": "mpfr",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["/usr/local", "/opt/mpfr", "/usr"]
    },
    {
      "name": "mpfr-include",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["/usr/local/include", "/opt/mpfr/include"]
    },
    {
      "name": "mpfr-lib",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["/usr/local/lib", "/opt/mpfr/lib"]
    },
    {
      "name": "gmp",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["/usr/local", "/opt/gmp", "/usr"]
    },
    {
      "name": "gmp-include",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["/usr/local/include", "/opt/gmp/include"]
    },
    {
      "name": "gmp-lib",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["/usr/local/lib", "/opt/gmp/lib"]
    },
    {
      "name": "stage1-libs",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["-lstdc++", "-lm", "no", "yes"]
    },
    {
      "name": "static-standard-libraries",
      "type": "choice",
      "default": "auto",
      "cli": "with",
      "choices": ["auto", "yes", "no"]
    },
    {
      "name": "stage1-ldflags",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["-static-libstdc++", "-static", "no", "yes"]
    },
    {
      "name": "boot-libs",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["-lstdc++", "no", "yes"]
    },
    {
      "name": "boot-ldflags",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["-static-libstdc++", "-static", "no", "yes"]
    },
    {
      "name": "isl",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["/usr/local", "/opt/isl", "no"]
    },
    {
      "name": "lto",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "linker-plugin-configure-flags",
      "type": "choice",
      "default": null,
      "cli": "enable",
      "choices": ["--verbose", "--enable-lto"]
    },
    {
      "name": "linker-plugin-flags",
      "type": "choice",
      "default": null,
      "cli": "enable",
      "choices": ["-O2", "-g"]
    },
    {
      "name": "host-shared",
      "type": "bool",
      "default": false,
      "cli": "enable"
    },
    {
      "name": "languages",
      "type": "choice",
      "default": "default",
      "cli": "enable",
      "choices": ["c", "c++", "fortran", "lto", "objc", "obj-c++", "go", "jit", "all", "default"]
    },
    {
      "name": "stage1-languages",
      "type": "choice",
      "default": "c",
      "cli": "enable",
      "choices": ["c", "c++", "go", "all"]
    },
    {
      "name": "objc-gc",
      "type": "bool",
      "default": false,
      "cli": "enable"
    },
    {
      "name": "target-bdw-gc",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["/usr/local", "/opt/bdw-gc"]
    },
    {
      "name": "target-bdw-gc-include",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["/usr/local/include"]
    },
    {
      "name": "target-bdw-gc-lib",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["/usr/local/lib"]
    },
    {
      "name": "build-sysroot",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["/sysroot", "/usr/sysroot", "/"]
    },
    {
      "name": "debug-prefix-map",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["/old=/new", "/src=/usr/src"]
    },
    {
      "name": "headers",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["yes", "no", "/usr/include"]
    },
    {
      "name": "libs",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["yes", "no", "/usr/lib"]
    },
    {
      "name": "build-config",
      "type": "choice",
      "default": "bootstrap-debug",
      "cli": "with",
      "choices": ["bootstrap-debug", "bootstrap-asan", "bootstrap-ubsan", "yes", "no"]
    },
    {
      "name": "vtable-verify",
      "type": "bool",
      "default": false,
      "cli": "enable"
    },
    {
      "name": "gdbtk",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "serial-configure",
      "type": "bool",
      "default": false,
      "cli": "enable"
    },
    {
      "name": "maintainer-mode",
      "type": "bool",
      "default": false,
      "cli": "enable"
    },
    {
      "name": "stage1-checking",
      "type": "choice",
      "default": null,
      "cli": "enable",
      "choices": ["yes", "no", "all", "release", "types", "misc"]
    },
    {
      "name": "target-optspace",
      "type": "bool",
      "default": false,
      "cli": "enable"
    },
    {
      "name": "build-time-tools",
      "type": "choice",
      "default": null,
      "cli": "with",
      "choices": ["/usr/local/bin", "/opt/tools/bin"]
    }
  ],"constraints": [
    {
      "opt": "gold",
      "val": "default",
      "choice": "==",
      "then": [
        {
          "opt": "ld",
          "val": "default",
          "choice": "!="
        }
      ],
      "desc": "either gold or ld can be the default ld, not both"
    },
    {
      "opt": "ld",
      "val": "default",
      "choice": "==",
      "then": [
        {
          "opt": "gold",
          "val": "default",
          "choice": "!="
        }
      ],
      "desc": "either gold or ld can be the default ld, not both"
    },
    {
      "opt": "ld",
      "val": "no",
      "choice": "==",
      "then": [
        {
          "opt": "gold",
          "val": "yes",
          "choice": "=="
        }
      ],
      "desc": "if ld is disabled, gold must be enabled"
    },
    {
      "opt": "pgo-build",
      "val": "lto",
      "choice": "==",
      "then": [
        {
          "opt": "bootstrap",
          "val": "no",
          "choice": "!="
        }
      ],
      "desc": "PGO build with LTO requires bootstrapping (yes or default)"
    },
    {
      "opt": "languages",
      "val": "jit",
      "choice": "==",
      "then": [
        {
          "opt": "host-shared",
          "val": true
        }
      ],
      "desc": "Enabling language 'jit' requires --enable-host-shared"
    },
    {
      "opt": "target-bdw-gc-lib",
      "val": null,
      "choice": "!=",
      "then": [
        {
          "opt": "target-bdw-gc-include",
          "val": null,
          "choice": "!="
        }
      ],
      "desc": "if target-bdw-gc-lib is specified, target-bdw-gc-include is required"
    },
    {
      "opt": "target-bdw-gc-include",
      "val": null,
      "choice": "!=",
      "then": [
        {
          "opt": "target-bdw-gc-lib",
          "val": null,
          "choice": "!="
        }
      ],
      "desc": "if target-bdw-gc-include is specified, target-bdw-gc-lib is required"
    }
  ],
  "removed": [
    {
      "name": "mpfr-dir deprecated options that will cause the build to fail if used. Use --with-mpfr=PATH or --with-mpfr-include=PATH plus --with-mpfr-lib=PATH instead.",
      "type": "string",
      "default": null,
      "cli": "with"
    },
    {
      "name": "gmp-dir deprecated options that will cause the build to fail if used. Use --with-gmp=PATH or --with-gmp-include=PATH plus --with-gmp-lib=PATH instead.",
      "type": "string",
      "default": null,
      "cli": "with"
    },
    {
      "name": "werror",
      "type": "bool",
      "default": false,
      "cli": "enable"
    }
  ]
}