#
# AFL/libFuzzer dictionary for XML
# -----------------------------
#
# Common XML tokens, delimiters, and keywords.
# Helps the fuzzer construct valid XML documents.
#

# XML declaration
xml_decl="<?xml version=\"1.0\"?>"
xml_decl_utf8="<?xml version=\"1.0\" encoding=\"UTF-8\"?>"

# Root element tags
tag_open="<root>"
tag_close="</root>"

# Common tags
tag_item_open="<item>"
tag_item_close="</item>"
tag_entry_open="<entry>"
tag_entry_close="</entry>"

# Empty element syntax
empty_tag_open="<tag/>"

# Attributes
attr_id="id=\"1\""
attr_name="name=\"test\""
attr_value="value=\"abc\""

# Markup delimiters
lt="<"
gt=">"
slash="/"
equals="="
quote="\""

# Comments and CDATA
comment="<!-- comment -->"
cdata="<![CDATA[some text]]>"

# Doctype and entities
doctype="<!DOCTYPE root>"
entity_decl="<!ENTITY xxe SYSTEM \"file:///dev/null\">"
entity_use="&xxe;"

# Processing instructions
pi="<?xml-stylesheet type=\"text/xsl\" href=\"style.xsl\"?>"

# Namespace examples
xmlns="xmlns:ns=\"http://example.com/ns\""
ns_tag_open="<ns:tag>"
ns_tag_close="</ns:tag>"
