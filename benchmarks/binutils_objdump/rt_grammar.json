{
    "cmdline":  "$inopts -f  $INPUTFILE",
    "exit_options": ["-v", "-i", "-H"],
    "connector": "=",
    "strmax":   3,
    "options":  [
                  {"opt":     "-a",
                   "type":    "bool"},
                  {"opt":     "-f",
                   "type":    "bool"},
                  {"opt":     "-p",
                   "type":    "bool"},
                  {"opt":     "-P",
                   "type":    "choice",
                   "choices": ["header", "aout", "sections", "syms", "relocs", "lineno", "loader", "except", "typchk", "traceback", "toc", "ldinfo"],
                   "connector": "="},
                  {"opt":     "-h",
                   "type":    "bool"},
                  {"opt":     "-x",
                   "type":    "bool"},
                  {"opt":     "-d",
                   "type":    "bool"},
                  {"opt":     "--disassemble",
                   "type":    "choice",
                   "choices": ["main", "function", "_start", "init", "entry"],
                   "connector": "="},
                  {"opt":     "-D",
                   "type":    "bool"},
                  {"opt":     "-S",
                   "type":    "bool"},
                  {"opt":     "--source-comment",
                   "type":    "choice",
                   "choices": ["//", "#", ";", "/*", "--"],
                   "connector": "="},
                  {"opt":     "-s",
                   "type":    "bool"},
                  {"opt":     "-g",
                   "type":    "bool"},
                  {"opt":     "-e",
                   "type":    "bool"},
                  {"opt":     "-G",
                   "type":    "bool"},
                  {"opt":     "-W",
                   "type":    "choice",
                   "choices": ["a", "abbrev", "A", "addr", "r", "aranges", "c", "cu_index", "L", "decodedline", "f", "frames", "F", "frames-interp", "g", "gdb_index", "i", "info", "o", "loc", "m", "macro", "p", "pubnames", "t", "pubtypes", "R", "Ranges", "l", "rawline", "s", "str", "O", "str-offsets", "u", "trace_abbrev", "T", "trace_aranges", "U", "trace_info"],
                   "connector": ""},
                  {"opt":     "--dwarf",
                   "type":    "choice",
                   "choices": ["rawline", "decodedline", "info", "abbrev", "aranges", "macro", "frames", "frames-interp", "str", "loc", "Ranges", "pubtypes", "trace_info", "trace_abbrev", "trace_aranges", "gdb_index", "addr", "cu_index", "links", "follow-links", "no-follow-links", "str-offsets", "pubnames"],
                   "connector": "="},
                  {"opt":     "-Wk",
                   "type":    "bool"},
                  {"opt":     "-WK",
                   "type":    "bool"},
                  {"opt":     "-WN",
                   "type":    "bool"},
                  {"opt":     "-L",
                   "type":    "bool"},
                  {"opt":     "--ctf",
                   "type":    "choice",
                   "choices": [".ctf", ".debug_ctf", "ctf_section", "CTF"],
                   "connector": "="},
                  {"opt":     "-t",
                   "type":    "bool"},
                  {"opt":     "-T",
                   "type":    "bool"},
                  {"opt":     "-r",
                   "type":    "bool"},
                  {"opt":     "-R",
                   "type":    "bool"},
                  {"opt":     "-v",
                   "type":    "bool"},
                  {"opt":     "-i",
                   "type":    "bool"},
                  {"opt":     "-H",
                   "type":    "bool"},
                  {"opt":     "-b",
                   "type":    "choice",
                   "choices": ["elf64-x86-64", "elf32-i386", "elf32-iamcu", "elf32-x86-64", "pei-i386", "pe-x86-64", "pei-x86-64", "elf64-l1om", "elf64-k1om", "elf64-little", "elf64-big", "elf32-little", "elf32-big", "srec", "symbolsrec", "verilog", "tekhex", "binary", "ihex", "plugin"],
                   "connector": " "},
                  {"opt":     "-m",
                   "type":    "choice",
                   "choices": ["i386", "i386:x86-64", "i386:x64-32", "i8086", "i386:intel", "i386:x86-64:intel", "i386:x64-32:intel", "iamcu", "iamcu:intel", "l1om", "l1om:intel", "k1om", "k1om:intel"],
                   "connector": " "},
                  {"opt":     "-j",
                   "type":    "choice",
                   "choices": [".text", ".data", ".rodata", ".bss", ".debug", ".symtab", ".strtab", ".init", ".fini"],
                   "connector": " "},
                  {"opt":     "-M",
                   "type":    "choice",
                   "choices": ["x86-64", "i386", "i8086", "att", "intel", "att-mnemonic", "intel-mnemonic", "addr64", "addr32", "addr16", "data32", "data16", "suffix", "amd64", "intel64"],
                   "connector": " "},
                  {"opt":     "-EB",
                   "type":    "bool"},
                  {"opt":     "-EL",
                   "type":    "bool"},
                  {"opt":     "--endian",
                   "type":    "choice",
                   "choices": ["big", "little"],
                   "connector": "="},
                  {"opt":     "--file-start-context",
                   "type":    "bool"},
                  {"opt":     "-I",
                   "type":    "choice",
                   "choices": ["/usr/include", "/usr/local/include", "./include", "../include", ".", "..", "/opt/include"],
                   "connector": " "},
                  {"opt":     "-l",
                   "type":    "bool"},
                  {"opt":     "-F",
                   "type":    "bool"},
                  {"opt":     "-C",
                   "type":    "choice",
                   "choices": ["auto", "gnu", "lucid", "arm", "hp", "edg", "gnu-v3", "java", "gnat"],
                   "connector": " "},
                  {"opt":     "--recurse-limit",
                   "type":    "bool"},
                  {"opt":     "--no-recurse-limit",
                   "type":    "bool"},
                  {"opt":     "-w",
                   "type":    "bool"},
                  {"opt":     "-z",
                   "type":    "bool"},
                  {"opt":     "--start-address",
                   "type":    "intnum",
                   "range":  [0,2147483647],
                   "connector": "="},
                  {"opt":     "--stop-address",
                   "type":    "intnum",
                   "range":  [0,2147483647],
                   "connector": "="},
                  {"opt":     "--no-addresses",
                   "type":    "bool"},
                  {"opt":     "--prefix-addresses",
                   "type":    "bool"},
                  {"opt":     "--show-raw-insn",
                   "type":    "bool"},
                  {"opt":     "--no-show-raw-insn",
                   "type":    "bool"},
                  {"opt":     "--insn-width",
                   "type":    "intnum",
                   "range":  [1,32],
                   "connector": "="},
                  {"opt":     "--adjust-vma",
                   "type":    "intnum",
                   "range":  [0,2147483647],
                   "connector": "="},
                  {"opt":     "--special-syms",
                   "type":    "bool"},
                  {"opt":     "--inlines",
                   "type":    "bool"},
                  {"opt":     "--prefix",
                   "type":    "choice",
                   "choices": ["/usr", "/usr/local", "/opt", ".", "..", "/home"],
                   "connector": "="},
                  {"opt":     "--prefix-strip",
                   "type":    "intnum",
                   "range":  [0,10],
                   "connector": "="},
                  {"opt":     "--dwarf-depth",
                   "type":    "intnum",
                   "range":  [0,100],
                   "connector": "="},
                  {"opt":     "--dwarf-start",
                   "type":    "intnum",
                   "range":  [0,2147483647],
                   "connector": "="},
                  {"opt":     "--dwarf-check",
                   "type":    "bool"},
                  {"opt":     "--ctf-parent",
                   "type":    "choice",
                   "choices": [".ctf", ".debug_ctf", "parent_section", "CTF"],
                   "connector": "="},
                  {"opt":     "--visualize-jumps",
                   "type":    "choice",
                   "choices": ["", "color", "extended-color", "off"],
                   "connector": "="}
                  ],
     "depend":   [],
     "conflict": [
                  ["--recurse-limit", "--no-recurse-limit"],
                  ["--show-raw-insn", "--no-show-raw-insn"],
                  ["-EB", "-EL"]
                 ],
     "maxcombs": 3
}