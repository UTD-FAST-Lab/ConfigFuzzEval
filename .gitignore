# Ignore the configuration directory created by locally-launched experiments.
config/

# Byte-compiled / optimized / DLL files.
__pycache__/
*.py[cod]
*$py.class

.pytype/

# Virtualenv
.venv

# Reports generated by FuzzBench.
report/
experiment-data/
report-data/

# Directories created by Jekyll.
.bundle/
docs/_site/
docs/vendor/

# Auto-generated build files.
docker/generated.mk

# Emacs backup files.
*~
\#*\#

.vscode

# Vim backup files.
.*.swp

# Diff files from matplotlib
*-failed-diff.png

# cts benchmarks
benchmarks/cts*

experiment-data/
report-data/
exp_archive/
configuration.yaml
config.yaml
# Local run logs and analysis reports
logs-reports/

# Local work kept out of git (e.g. the original aflplusplus_2w prototype)
uncommitted/

# Your experiment file (see "Experiment files" in README.md); the README has an example.
/experiment.yaml

# Web app queue, saved experiment files and previews
webapp/instance/
