{
    "cmdline":  "$inopts $INPUTFILE",
    "exit_options": ["-h", "-V"],
    "connector": "=",
    "strmax":   3,
    "options":  [
                  {"opt":     "-a",
                   "type":    "bool"},
                  {"opt":     "-A",
                   "type":    "bool"},
                  {"opt":     "-B",
                   "type":    "bool"},
                  {"opt":     "-C",
                   "type":    "choice",
                   "choices": ["auto", "gnu", "lucid","arm", "hp", "edg", "gnu-v3", "java", "gnat"],
                   "connector": " "},
                  {"opt":     "--no-demangle",
                   "type":    "bool"},
                  {"opt":     "--recurse-limit",
                   "type":    "bool"},
                  {"opt":     "--no-recurse-limit",
                   "type":    "bool"},
                  {"opt":     "-D",
                   "type":    "bool"},
                  {"opt":     "--defined-only",
                   "type":    "bool"},
                  {"opt":     "-e",
                   "type":    "bool"},
                  {"opt":     "-f",
                   "type":    "choice",
                   "choices": ["bsd", "sysv", "posix", "just-symbols"],
                   "connector": " "},
                  {"opt":     "-g",
                   "type":    "bool"},
                  {"opt":     "--ifunc-chars",
                   "type":    "choice",
                   "choices": ["<>", "[]", "{}", "()", "@@", "##"],
                   "connector": "="},
                  {"opt":     "-j",
                   "type":    "bool"},
                  {"opt":     "-l",
                   "type":    "bool"},
                  {"opt":     "-n",
                   "type":    "bool"},
                  {"opt":     "-o",
                   "type":    "bool"},
                  {"opt":     "-p",
                   "type":    "bool"},
                  {"opt":     "-P",
                   "type":    "bool"},
                  {"opt":     "-r",
                   "type":    "bool"},
                  {"opt":     "-S",
                   "type":    "bool"},
                  {"opt":     "-s",
                   "type":    "bool"},
                  {"opt":     "--quiet",
                   "type":    "bool"},
                  {"opt":     "--size-sort",
                   "type":    "bool"},
                  {"opt":     "--special-syms",
                   "type":    "bool"},
                  {"opt":     "--synthetic",
                   "type":    "bool"},
                  {"opt":     "-t",
                   "type":    "choice",
                   "choices": ["x", "d", "o"],
                   "connector": " "},
                  {"opt":     "--target",
                   "type":    "choice",
                   "choices": ["elf64-x86-64","elf32-i386","elf32-iamcu","elf32-x86-64","pei-i386","pe-x86-64","pei-x86-64","elf64-l1om","elf64-k1om","elf64-little","elf64-big","elf32-little","elf32-big","srec","symbolsrec","verilog","tekhex","binary","ihex"],
                   "connector": "="},
                  {"opt":     "-u",
                   "type":    "bool"},
                  {"opt":     "--with-symbol-versions",
                   "type":    "bool"},
                  {"opt":     "-X",
                   "type":    "choice",
                   "choices": ["32_64"],
                   "connector": " "},
                  {"opt":     "-h",
                   "type":    "bool"},
                  {"opt":     "-V",
                   "type":    "bool"}
                 ],
     "depend":   [],
     "conflict": [
                  ["--defined-only", "-u"],
                  ["-n", "-p"],
                  ["-n", "-r"],
                  ["-n", "--size-sort"],
                  ["-p", "-r"],
                  ["-p", "--size-sort"],
                  ["-r", "--size-sort"],
                  ["-C", "--no-demangle"],
                  ["--recurse-limit", "--no-recurse-limit"],
                  ["-B", "-f"],
                  ["-B", "-j"],
                  ["-B", "-P"],
                  ["-f", "-j"],
                  ["-f", "-P"],
                  ["-j", "-P"],
                  ["-A", "-o"]
                 ],
     "maxcombs": 3
}