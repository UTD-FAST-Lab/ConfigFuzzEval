{
  "name": "file_file",
  "options": [
    {
      "name": "elf",
      "type": "bool",
      "default": true,
      "cli": "--enable-elf",
      "desc": "disable builtin ELF support"
    },
    {
      "name": "zlib",
      "type": "bool",
      "default": true,
      "cli": "--enable-zlib",
      "desc": "disable zlib compression support"
    },
    {
      "name": "bzlib",
      "type": "bool",
      "default": true,
      "cli": "--enable-bzlib",
      "desc": "disable bz2lib compression support"
    },
    {
      "name": "xzlib",
      "type": "bool",
      "default": true,
      "cli": "--enable-xzlib",
      "desc": "disable liblzma/xz compression support"
    },
    {
      "name": "fsect-man5",
      "type": "bool",
      "default": false,
      "cli": "--enable-fsect-man5",
      "desc": "enable file formats in man section 5"
    },
    {
      "name": "warnings",
      "type": "bool",
      "default": true,
      "cli": "--enable-warnings",
      "desc": "enable compiler warnings"
    },
    {
      "name": "silent-rules",
      "type": "bool",
      "default": true,
      "cli": "--enable-silent-rules",
      "desc": "less verbose build output (undo: \"make V=1\")"
    },
    {
      "name": "dependency-tracking",
      "type": "bool",
      "default": true,
      "cli": "--enable-dependency-tracking",
      "desc": "do not reject slow dependency extractors"
    },
    {
      "name": "fast-install",
      "type": "bool",
      "default": true,
      "cli": "--enable-fast-install",
      "desc": "optimize for fast installation"
    }
  ],
  "removed": ["--enable-elf-core","--enable-zstdlib,lzlib,lrziplib,libseccomp","--disable-shared", "--enable-static"]
}