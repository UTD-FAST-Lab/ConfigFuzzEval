{
  "name": "file",
  "options": [
    {
      "name": "elf",
      "type": "bool",
      "default": true,
      "cli": "--disable-elf",
      "desc": "disable builtin ELF support"
    },
    {
      "name": "elf-core",
      "type": "bool",
      "default": true,
      "cli": "--disable-elf-core",
      "desc": "disable ELF core file support"
    },
    {
      "name": "zlib",
      "type": "bool",
      "default": true,
      "cli": "--disable-zlib",
      "desc": "disable zlib compression support"
    },
    {
      "name": "bzlib",
      "type": "bool",
      "default": true,
      "cli": "--disable-bzlib",
      "desc": "disable bz2lib compression support"
    },
    {
      "name": "xzlib",
      "type": "bool",
      "default": true,
      "cli": "--disable-xzlib",
      "desc": "disable liblzma/xz compression support"
    },
    {
      "name": "zstdlib",
      "type": "bool",
      "default": true,
      "cli": "--disable-zstdlib",
      "desc": "disable zstdlib compression support"
    },
    {
      "name": "lzlib",
      "type": "bool",
      "default": true,
      "cli": "--disable-lzlib",
      "desc": "disable liblz (lzip) compression support"
    },
    {
      "name": "lrziplib",
      "type": "bool",
      "default": true,
      "cli": "--disable-lrziplib",
      "desc": "disable liblrzip (lrzip) compression support"
    },
    {
      "name": "libseccomp",
      "type": "bool",
      "default": true,
      "cli": "--disable-libseccomp",
      "desc": "disable libseccomp sandboxing"
    },
    {
      "name": "fsect-man5",
      "type": "bool",
      "default": false,
      "cli": "--enable-fsect-man5",
      "desc": "enable file formats in man section 5"
    }
  ]
}
