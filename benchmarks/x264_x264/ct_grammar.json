{
  "name": "x264_x264",
  "options": [
    {
      "name": "shared",
      "type": "bool",
      "default": false,
      "cli": "enable"
    },
    {
      "name": "static",
      "type": "bool",
      "default": false,
      "cli": "enable"
    },
    {
      "name": "bashcompletion",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "opencl",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "gpl",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "thread",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "win32thread",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "interlaced",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "asm",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "lto",
      "type": "bool",
      "default": false,
      "cli": "enable"
    },
    {
      "name": "debug",
      "type": "bool",
      "default": false,
      "cli": "enable"
    },
    {
      "name": "gprof",
      "type": "bool",
      "default": false,
      "cli": "enable"
    },
    {
      "name": "strip",
      "type": "bool",
      "default": false,
      "cli": "enable"
    },
    {
      "name": "pic",
      "type": "bool",
      "default": false,
      "cli": "enable"
    },
    {
      "name": "avs",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "swscale",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "lavf",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "ffms",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "gpac",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "lsmash",
      "type": "bool",
      "default": true,
      "cli": "enable"
    }
  ],
  "constraints": [
    {
      "opt": "shared",
      "val": true,
      "then": [
        {
          "opt": "pic",
          "val": true
        }
      ],
      "desc": "Shared library build requires Position Independent Code (PIC)"
    },
    {
      "opt": "lavf",
      "val": true,
      "then": [
        {
          "opt": "swscale",
          "val": true
        }
      ],
      "desc": "libavformat (lavf) support requires swscale support"
    },
    {
      "opt": "ffms",
      "val": true,
      "then": [
        {
          "opt": "swscale",
          "val": true
        }
      ],
      "desc": "ffmpegsource (ffms) support requires swscale support"
    }
  ],
  "removed": [
    {
      "name": "cli",
      "reason": "hardcoded in build.sh because it is needed for command line use",
      "old": {
        "type": "bool",
        "default": true,
        "cli": "disable"
      }
    },
    {
      "name": "constraint: if cli=false then avs=false, lavf=false, ffms=false, gpac=false, lsmash=false, swscale=false",
      "reason": "refers to the removed option cli",
      "old": {
        "opt": "cli",
        "val": false,
        "then": [
          {
            "opt": "avs",
            "val": false
          },
          {
            "opt": "lavf",
            "val": false
          },
          {
            "opt": "ffms",
            "val": false
          },
          {
            "opt": "gpac",
            "val": false
          },
          {
            "opt": "lsmash",
            "val": false
          },
          {
            "opt": "swscale",
            "val": false
          }
        ],
        "desc": "Disabling CLI disables all video input/output libraries (avs, lavf, ffms, gpac, lsmash, swscale)"
      }
    },
    {
      "name": "prefix",
      "reason": "plain --name=value option: not expressible with the enable/with grammar format",
      "old": {
        "name": "prefix",
        "type": "choice",
        "default": "/usr/local",
        "cli": "",
