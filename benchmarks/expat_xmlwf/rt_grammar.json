{
    "cmdline": "$inopts $INPUTFILE",
    "exit_options": ["-h", "-v"],
    "connector": " ",
    "strmax": 3,
    "options": [
        {
            "opt": "-s",
            "type": "bool"
        },
        {
            "opt": "-n",
            "type": "bool"
        },
        {
            "opt": "-p",
            "type": "bool"
        },
        {
            "opt": "-x",
            "type": "bool"
        },
        {
            "opt": "-e",
            "type": "choice",
            "choices": ["UTF-8", "UTF-16", "ISO-8859-1", "US-ASCII", "windows-1252"],
            "connector": " "
        },
        {
            "opt": "-w",
            "type": "bool"
        },
        {
            "opt": "-r",
            "type": "bool"
        },
        {
            "opt": "-g",
            "type": "intnum",
            "range": [1, 65536],
            "connector": " "
        },
        {
            "opt": "-k",
            "type": "bool"
        },
        {
            "opt": "-d",
            "type": "choice",
            "choices": ["./output", "./out", "/tmp", ".", ".."],
            "connector": " "
        },
        {
            "opt": "-c",
            "type": "bool"
        },
        {
            "opt": "-m",
            "type": "bool"
        },
        {
            "opt": "-t",
            "type": "bool"
        },
        {
            "opt": "-N",
            "type": "bool"
        },
        {
            "opt": "-a",
            "type": "intnum",
            "range": [1, 1000],
            "connector": " "
        },
        {
            "opt": "-b",
            "type": "intnum",
            "range": [1, 67108864],
            "connector": " "
        },
        {
            "opt": "-q",
            "type": "bool"
        },
        {
            "opt": "-h",
            "type": "bool"
        },
        {
            "opt": "-v",
            "type": "bool"
        }
    ],
    "depend": [],
    "conflict": [
        ["-c", "-m"],
        ["-c", "-t"],
        ["-m", "-t"]
    ],
    "maxcombs": 3
}