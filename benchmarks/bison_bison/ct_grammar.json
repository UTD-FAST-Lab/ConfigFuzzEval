{
  "name": "bison_bison",
  "options": [
    {
      "name": "largefile",
      "type": "bool",
      "default": true,
      "cli": "--enable-largefile"
    },
    {
      "name": "year2038",
      "type": "bool",
      "default": true,
      "cli": "--enable-year2038"
    },
    {
      "name": "threads",
      "type": "enum",
      "default": null,
      "values": [
        "isoc",
        "posix",
        "isoc+posix",
        "windows",
        "no"
      ],
      "cli": "--enable-threads"
    },
    {
      "name": "rpath",
      "type": "bool",
      "default": true,
      "cli": "--enable-rpath"
    },
    {
      "name": "yacc",
      "type": "bool",
      "default": true,
      "cli": "--enable-yacc"
    },
    {
      "name": "cross-guesses",
      "type": "enum",
      "default": null,
      "values": [
        "conservative",
        "risky"
      ],
      "cli": "--enable-cross-guesses"
    },
    {
      "name": "assert",
      "type": "bool",
      "default": true,
      "cli": "--enable-assert"
    },
    {
      "name": "relocatable",
      "type": "bool",
      "default": false,
      "cli": "--enable-relocatable"
    },
    {
      "name": "nls",
      "type": "bool",
      "default": true,
      "cli": "--enable-nls"
    },
    {
      "name": "gcc-warnings",
      "type": "bool",
      "default": false,
      "cli": "--enable-gcc-warnings"
    },
    {
      "name": "dependency-tracking",
      "type": "bool",
      "default": true,
      "cli": "--enable-dependency-tracking"
    },
    {
      "name": "silent-rules",
      "type": "bool",
      "default": true,
      "cli": "--enable-silent-rules"
    },
    {
      "name": "libtextstyle-prefix",
      "type": "string",
      "default": null,
      "cli": "--with-libtextstyle-prefix"
    },
    {
      "name": "gnu-ld",
      "type": "bool",
      "default": false,
      "cli": "--with-gnu-ld"
    },
    {
      "name": "libiconv-prefix",
      "type": "string",
      "default": null,
      "cli": "--with-libiconv-prefix"
    },
    {
      "name": "libintl-prefix",
      "type": "string",
      "default": null,
      "cli": "--with-libintl-prefix"
    }
  ]
}