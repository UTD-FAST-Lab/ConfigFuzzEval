{
  "name": "pcre2_pcre2test",
  "options": [
    {
      "name": "pcre2-8",
      "type": "bool",
      "default": true,
      "cli": "--enable-pcre2-8",
      "override": "--enable-pcre2-8",
        "pairwise_constraints" : [
            [true,[
              ["pcre2-16",false],
              ["pcre2-32",false]
            ]]
          ]
    },
    {
      "name": "pcre2-16",
      "type": "bool",
      "default": false,
      "cli": "--enable-pcre2-16",
      "pairwise_constraints" : [
          [true,[
            ["pcre2-8",false],
            ["pcre2-32",false]
          ]]
        ]
    },
    {
      "name": "pcre2-32",
      "type": "bool",
      "default": false,
      "cli": "--enable-pcre2-32",
      "pairwise_constraints" : [
          [true,[
            ["pcre2-8",false],
            ["pcre2-16",false]
          ]]
        ]
    },
    {
      "name": "debug",
      "type": "bool",
      "default": false,
      "cli": "--enable-debug"
    },
    {
      "name": "jit",
      "type": "bool",
      "default": false,
      "cli": "--enable-jit"
    },
    {
      "name": "jit-sealloc",
      "type": "bool",
      "default": false,
      "cli": "--enable-jit-sealloc"
    },
    {
      "name": "pcre2grep-jit",
      "type": "bool",
      "default": true,
      "cli": "--enable-pcre2grep-jit"
    },
    {
      "name": "pcre2grep-callout",
      "type": "bool",
      "default": true,
      "cli": "--enable-pcre2grep-callout"
    },
    {
      "name": "pcre2grep-callout-fork",
      "type": "bool",
      "default": true,
      "cli": "--enable-pcre2grep-callout-fork"
    },
    {
      "name": "rebuild-chartables",
      "type": "bool",
      "default": false,
      "cli": "--enable-rebuild-chartables"
    },
    {
      "name": "unicode",
      "type": "bool",
      "default": true,
      "cli": "--enable-unicode"
    },
    {
      "name": "newline-is-cr",
      "type": "bool",
      "default": false,
      "cli": "--enable-newline-is-cr"
    },
    {
      "name": "newline-is-lf",
      "type": "bool",
      "default": true,
      "cli": "--enable-newline-is-lf"
    },
    {
      "name": "newline-is-crlf",
      "type": "bool",
      "default": false,
      "cli": "--enable-newline-is-crlf"
    },
    {
      "name": "newline-is-anycrlf",
      "type": "bool",
      "default": false,
      "cli": "--enable-newline-is-anycrlf"
    },
    {
      "name": "newline-is-any",
      "type": "bool",
      "default": false,
      "cli": "--enable-newline-is-any"
    },
    {
      "name": "newline-is-nul",
      "type": "bool",
      "default": false,
      "cli": "--enable-newline-is-nul"
    },
    {
      "name": "bsr-anycrlf",
      "type": "bool",
      "default": false,
      "cli": "--enable-bsr-anycrlf"
    },
    {
      "name": "never-backslash-C",
      "type": "bool",
      "default": false,
      "cli": "--enable-never-backslash-C"
    },
    {
      "name": "ebcdic",
      "type": "bool",
      "default": false,
      "cli": "--enable-ebcdic",
      "pairwise_constraints" : [
          [true,[
            ["unicode",false]
          ]]
        ]
    },
    {
      "name": "ebcdic-nl25",
      "type": "bool",
      "default": false,
      "cli": "--enable-ebcdic-nl25",
      "pairwise_constraints" : [
          [true,[
            ["ebcdic",true]
          ]]
        ]
    },
    {
      "name": "ebcdic-ignoring-compiler",
      "type": "bool",
      "default": false,
      "cli": "--enable-ebcdic-ignoring-compiler",
      "pairwise_constraints" : [
          [true,[
            ["ebcdic",true]
          ]]
        ]
    },
    {
      "name": "pcre2grep-libz",
      "type": "bool",
      "default": false,
      "cli": "--enable-pcre2grep-libz"
    },
    {
      "name": "pcre2grep-libbz2",
      "type": "bool",
      "default": false,
      "cli": "--enable-pcre2grep-libbz2"
    },
    {
      "name": "pcre2test-libedit",
      "type": "bool",
      "default": false,
      "cli": "--enable-pcre2test-libedit"
    },
    {
      "name": "pcre2test-libreadline",
      "type": "bool",
      "default": false,
      "cli": "--enable-pcre2test-libreadline"
    },
    {
      "name": "valgrind",
      "type": "bool",
      "default": false,
      "cli": "--enable-valgrind"
    },
    {
      "name": "coverage",
      "type": "bool",
      "default": false,
      "cli": "--enable-coverage"
    },
    {
      "name": "fuzz-support",
      "type": "bool",
      "default": false,
      "cli": "--enable-fuzz-support"
    },
    {
      "name": "diff-fuzz-support",
      "type": "bool",
      "default": false,
      "cli": "--enable-diff-fuzz-support"
    },
    {
      "name": "percent-zt",
      "type": "bool",
      "default": true,
      "cli": "--enable-percent-zt"
    },
    {
      "name": "Werror",
      "type": "bool",
      "default": false,
      "cli": "--enable-Werror"
    },
    {
      "name": "errwarn",
      "type": "bool",
      "default": false,
      "cli": "--enable-errwarn"
    },
    {
      "name": "pcre2grep-bufsize",
      "type": "value",
      "default": 20480,
      "cli": "--with-pcre2grep-bufsize"
    },
    {
      "name": "pcre2grep-max-bufsize",
      "type": "value",
      "default": 1048576,
      "cli": "--with-pcre2grep-max-bufsize"
    },
    {
      "name": "link-size",
      "type": "enum",
      "values": [2,3,4],
      "default": 2,
      "cli": "--with-link-size"
    },
    {
      "name": "max-varlookbehind",
      "type": "value",
      "default": 255,
      "cli": "--with-max-varlookbehind"
    },
    {
      "name": "parens-nest-limit",
      "type": "value",
      "default": 250,
      "cli": "--with-parens-nest-limit"
    },
    {
      "name": "heap-limit",
      "type": "value",
      "default": 20000000,
      "cli": "--with-heap-limit"
    },
    {
      "name": "match-limit",
      "type": "value",
      "default": 10000000,
      "cli": "--with-match-limit"
    },
    {
      "name": "match-limit-depth",
      "type": "value",
      "default": "MATCH_LIMIT",
      "cli": "--with-match-limit-depth"
    }
  ]
}
