{
    "cmdline":  "$inopts --input-res 64x64  -o /dev/null $INPUTFILE",
    "connector": "=",
    "strmax":   3,
    "options":  [
                  {"opt":     "-h",
                   "type":    "bool"},
                  {"opt":     "--longhelp",
                   "type":    "bool"},
                  {"opt":     "--fullhelp",
                   "type":    "bool"},
                  {"opt":     "--profile",
                   "type":    "choice",
                   "choices": ["baseline", "main", "high", "high10", "high422", "high444"],
                   "connector": " "},
                  {"opt":     "--preset",
                   "type":    "choice",
                   "choices": ["ultrafast", "superfast", "veryfast", "faster", "fast", "medium", "slow", "slower", "veryslow", "placebo"],
                   "connector": " "},
                  {"opt":     "--tune",
                   "type":    "choice",
                   "choices": ["film", "animation", "grain", "stillimage", "psnr", "ssim", "fastdecode", "zerolatency", "film,fastdecode", "animation,fastdecode", "grain,fastdecode", "stillimage,fastdecode", "psnr,fastdecode", "ssim,fastdecode", "film,zerolatency", "animation,zerolatency", "grain,zerolatency", "stillimage,zerolatency", "psnr,zerolatency", "ssim,zerolatency"],
                   "connector": " "},
                  {"opt":     "-I",
                   "type":    "intnum",
                   "range":  [1,100000],
                   "connector": " "},
                  {"opt":     "--tff",
                   "type":    "bool"},
                  {"opt":     "--bff",
                   "type":    "bool"},
                  {"opt":     "--pulldown",
                   "type":    "choice",
                   "choices": ["none", "22", "32", "64", "double", "triple", "euro"],
                   "connector": " "},
                  {"opt":     "-B",
                   "type":    "intnum",
                   "range":  [1,100000],
                   "connector": " "},
                  {"opt":     "--crf",
                   "type":    "intnum",
                   "range":  [0,51],
                   "connector": " "},
                  {"opt":     "--qp",
                   "type":    "intnum",
                   "range":  [0,69],
                   "connector": " "},
                  {"opt":     "--vbv-maxrate",
                   "type":    "intnum",
                   "range":  [0,100000],
                   "connector": " "},
                  {"opt":     "--vbv-bufsize",
                   "type":    "intnum",
                   "range":  [0,100000],
                   "connector": " "},
                  {"opt":     "-p",
                   "type":    "choice",
                   "choices": ["1", "2"],
                   "connector": " "},
                  {"opt":     "-o",
                   "type":    "choice",
                   "choices": ["output.264", "output.mkv", "output.flv", "output.mp4", "out.264", "out.mkv", "out.flv", "out.mp4"],
                   "connector": " "},
                  {"opt":     "--sar",
                   "type":    "choice",
                   "choices": ["1:1", "4:3", "16:9", "2.35:1", "2.40:1", "64:27"],
                   "connector": " "},
                  {"opt":     "--fps",
                   "type":    "choice",
                   "choices": ["23.976", "24", "25", "29.97", "30", "50", "59.94", "60", "24000/1001", "30000/1001", "60000/1001"],
                   "connector": " "},
                  {"opt":     "--seek",
                   "type":    "intnum",
                   "range":  [0,1000000],
                   "connector": " "},
                  {"opt":     "--frames",
                   "type":    "intnum",
                   "range":  [1,1000000],
                   "connector": " "},
                  {"opt":     "--level",
                   "type":    "choice",
                   "choices": ["1", "1.1", "1.2", "1.3", "2", "2.1", "2.2", "3", "3.1", "3.2", "4", "4.1", "4.2", "5", "5.1", "5.2"],
                   "connector": " "},
                  {"opt":     "--quiet",
                   "type":    "bool"},
                  {"opt":     "--vf",
                   "type":    "choice",
                   "choices": ["crop:0,0,0,0", "crop:8,8,8,8", "crop:16,16,16,16", "select_every:2,0", "select_every:2,1", "select_every:3,0", "select_every:3,1", "select_every:3,2"],
                   "connector": " "}
                  ],
     "depend":   [],
     "conflict": [
                  ["-h", "--longhelp"],
                  ["-h", "--fullhelp"],
                  ["--longhelp", "--fullhelp"],
                  ["--tff", "--bff"],
                  ["--crf", "--qp"],
                  ["--crf", "-B"],
                  ["--qp", "-B"]
                 ],
     "maxcombs": 3
}