{
  "name": "libxml2_xmllint",
  "options": [
    {
      "name": "silent-rules",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "maintainer-mode",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "c14n",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "catalog",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "debug",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "history",
      "type": "bool",
      "default": false,
      "cli": "with"
    },
    {
      "name": "readline",
      "type": "choice",
      "default": false,
      "cli": "with",
      "choices": [
        true,
        false,
        "/usr/local",
        "/opt/readline"
      ]
    },
    {
      "name": "html",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "http",
      "type": "bool",
      "default": false,
      "cli": "with"
    },
    {
      "name": "iconv",
      "type": "choice",
      "default": true,
      "cli": "with",
      "choices": [
        true,
        false,
        "/usr/local",
        "/opt/iconv"
      ]
    },
    {
      "name": "icu",
      "type": "choice",
      "default": false,
      "cli": "with",
      "choices": [
        true,
        false,
        "/usr/local/icu",
        "/opt/icu"
      ]
    },
    {
      "name": "iso8859x",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "modules",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "output",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "pattern",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "push",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "reader",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "regexps",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "relaxng",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "sax1",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "schemas",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "schematron",
      "type": "bool",
      "default": false,
      "cli": "with"
    },
    {
      "name": "threads",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "thread-alloc",
      "type": "bool",
      "default": false,
      "cli": "with"
    },
    {
      "name": "valid",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "winpath",
      "type": "choice",
      "default": "auto",
      "cli": "with",
      "choices": [
        "yes",
        "no",
        "auto"
      ]
    },
    {
      "name": "writer",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "xinclude",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "xpath",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "xptr",
      "type": "bool",
      "default": true,
      "cli": "with"
    },
    {
      "name": "tls",
      "type": "bool",
      "default": false,
      "cli": "with"
    },
    {
      "name": "minimum",
      "type": "bool",
      "default": false,
      "cli": "with"
    }
  ],
  "constraints": [
    {
      "opt": "c14n",
      "val": true,
      "then": [
        {
          "opt": "output",
          "val": true
        },
        {
          "opt": "xpath",
          "val": true
        }
      ],
      "desc": "C14N force enables output and xpath."
    },
    {
      "opt": "relaxng",
      "val": true,
      "then": [
        {
          "opt": "regexps",
          "val": true
        },
        {
          "opt": "schemas",
          "val": true
        }
      ],
      "desc": "RelaxNG force enables regexps and schemas."
    },
    {
      "opt": "schemas",
      "val": true,
      "then": [
        {
          "opt": "pattern",
          "val": true
        },
        {
          "opt": "regexps",
          "val": true
        }
      ],
      "desc": "Schemas force enables pattern and regexps."
    },
    {
      "opt": "schematron",
      "val": true,
      "then": [
        {
          "opt": "pattern",
          "val": true
        },
        {
          "opt": "xpath",
          "val": true
        }
      ],
      "desc": "Schematron force enables pattern and xpath."
    },
    {
      "opt": "reader",
      "val": true,
      "then": [
        {
          "opt": "push",
          "val": true
        }
      ],
      "desc": "Reader force enables push."
    },
    {
      "opt": "writer",
      "val": true,
      "then": [
        {
          "opt": "output",
          "val": true
        },
        {
          "opt": "push",
          "val": true
        }
      ],
      "desc": "Writer force enables output and push."
    },
    {
      "opt": "xptr",
      "val": true,
      "then": [
        {
          "opt": "xpath",
          "val": true
        }
      ],
      "desc": "XPointer force enables xpath."
    },
    {
      "opt": "history",
      "val": true,
      "then": [
        {
          "opt": "readline",
          "val": true
        }
      ],
      "desc": "History force enables readline."
    },
    {
      "opt": "http",
      "val": true,
      "then": [
        {
          "opt": "output",
          "val": true
        }
      ],
      "desc": "Found bug."
    }
  ],
  "removed": [
    {
      "name": "legacy Legacy is removed because it just enables other flags and is hence misleading",
      "type": "bool",
      "default": false,
      "cli": "with"
    },
    {
      "opt": "legacy",
      "val": true,
      "then": [
        {
          "opt": "schematron",
          "val": true
        },
        {
          "opt": "zlib",
          "val": true
        }
      ]
    },
    {
      "name": "shared hardcoded in build scripts",
      "type": "bool",
      "default": true,
      "cli": "enable"
    },
    {
      "name": "static hardcoded in build scripts",
      "type": "bool",
      "default": false,
      "cli": "enable"
    },
    {
      "name": "docs hardcoded in build scripts",
      "type": "bool",
      "default": false,
      "cli": "with"
    },
    {
      "name": "zlib",
      "type": "choice",
      "default": false,
      "cli": "with",
      "choices": [
        true,
        false,
        "/usr/local/zlib",
        "/opt/zlib"
      ]
    },
    {
      "name": "python",
      "type": "bool",
      "default": true,
      "cli": "with"
    }

  ]
}