{
    "cmdline": "$inopts $INPUTFILE",
    "exit_options": ["-help", "-v", "-unittest", "-C", "-error", "-LM", "-LP", "-LS"],
    "connector": " ",
    "strmax": 3,
    "options": [
        {
            "opt": "-8",
            "type": "bool"
        },
        {
            "opt": "-ac",
            "type": "bool"
        },
        {
            "opt": "-AC",
            "type": "bool"
        },
        {
            "opt": "-b",
            "type": "bool"
        },
        {
            "opt": "-C",
            "type": "choice",
            "choices": ["backslash-C", "bsr", "ebcdic", "ebcdic-io", "ebcdic-nl25", "jit", "jitusable", "linksize", "newline", "pcre2-8", "pcre2-16", "pcre2-32", "unicode"],
            "connector": " "
        },
        {
            "opt": "--color",
            "type": "choice",
            "choices": ["always", "auto", "never"],
            "connector": "="
        },
        {
            "opt": "--colour",
            "type": "choice",
            "choices": ["always", "auto", "never"],
            "connector": "="
        },
        {
            "opt": "-d",
            "type": "bool"
        },
        {
            "opt": "-dfa",
            "type": "bool"
        },
        {
            "opt": "-E",
            "type": "bool"
        },
        {
            "opt": "-error",
            "type": "choice",
            "choices": ["1", "2", "3", "1,2", "1,2,3"],
            "connector": " "
        },
        {
            "opt": "-help",
            "type": "bool"
        },
        {
            "opt": "-i",
            "type": "bool"
        },
        {
            "opt": "-jit",
            "type": "bool"
        },
        {
            "opt": "-jitfast",
            "type": "bool"
        },
        {
            "opt": "-jitverify",
            "type": "bool"
        },
        {
            "opt": "-LM",
            "type": "bool"
        },
        {
            "opt": "-LP",
            "type": "bool"
        },
        {
            "opt": "-LS",
            "type": "bool"
        },
        {
            "opt": "-malloc",
            "type": "bool"
        },
        {
            "opt": "-q",
            "type": "bool"
        },
        {
            "opt": "-pattern",
            "type": "choice",
            "choices": ["anchored", "caseless", "dotall", "multiline", "extended"],
            "connector": " "
        },
        {
            "opt": "-subject",
            "type": "choice",
            "choices": ["notbol", "noteol", "notempty", "partial_soft", "partial_hard"],
            "connector": " "
        },
        {
            "opt": "-S",
            "type": "intnum",
            "range": [1, 1024],
            "connector": " "
        },
        {
            "opt": "-t",
            "type": "intnum",
            "range": [1, 10000],
            "connector": " "
        },
        {
            "opt": "-tm",
            "type": "intnum",
            "range": [1, 10000],
            "connector": " "
        },
        {
            "opt": "-T",
            "type": "bool"
        },
        {
            "opt": "-TM",
            "type": "bool"
        },
        {
            "opt": "-unittest",
            "type": "bool"
        },
        {
            "opt": "-v",
            "type": "bool"
        }
    ],
    "depend": [],
    "conflict": [
        ["-t", "-tm"],
        ["-t", "-T"],
        ["-t", "-TM"],
        ["-tm", "-T"],
        ["-tm", "-TM"],
        ["-T", "-TM"],
        ["--color", "--colour"]
    ],
    "maxcombs": 2
}